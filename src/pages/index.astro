---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Our Android Apps</h1>
				<p class="tagline">
					Quality apps crafted by <strong>MK Pixel Technologies</strong> — built with care,
					available now on Google Play Store.
				</p>
				<p class="cta">
					<a href="https://play.google.com/store/apps/dev?id=YOUR_DEV_ID" target="_blank">
						▶ Visit Our Play Store Page
					</a>
				</p>
			</section>

			<section>
				<h2>📱 Featured Apps</h2>

				<!-- APP 1 — copy this block for each of your apps -->
				<div class="app-card">
					<img src="/allrecipesindianfood_icon_512.png" alt="All Recipes Indian Food icon" class="app-icon" />
					<div class="app-info">
						<h3>All Recipes Indian Food</h3>
						<p class="badge">1000+ Downloads</p>
					<p>
	Beautiful Indian food recipes with a clean interface — ingredients list,
	step-by-step instructions, and a built-in cooking timer for every recipe.
</p>
						<a class="install-btn" href="https://play.google.com/store/apps/details?id=com.mkdhapa.allrecipesindianfood&pcampaignid=web_share" target="_blank">
							Install on Google Play
						</a>
					</div>
				</div>

				<!-- APP 2 -->
				<div class="app-card">
					<img src="/khatavahi_icon_512.png" alt="Account book : Khatavahi icon" class="app-icon" />
					<div class="app-info">
						<h3>Account book : Khatavahi</h3>
						<p class="badge">🆕 New on Play Store</p>
						<p>
							Account Book is a simple and powerful digital account book app designed for shopkeepers, freelancers, small businesses and personal use.
						</p>
						<a class="install-btn" href="https://play.google.com/store/apps/details?id=com.mkdhapa.khatavahi&pcampaignid=web_share" target="_blank">
							Install on Google Play
						</a>
					</div>
				</div>

								<!-- APP 3 — copy this block for each of your apps -->
				<div class="app-card">
					<img src="/detox_icon_512.png" alt="Detox : Choose App And Block icon" class="app-icon" />
					<div class="app-info">
						<h3>Detox : Choose App and Block</h3>
						<p class="badge">🆕 New on Play Store</p>
						<p>
	📱 Take control of your digital life. Unlike other app blockers, Detox lets
	<strong>you</strong> choose exactly which apps to block — set a duration for hours
	or days, start your focus session, and get things done.
</p>
						<a class="install-btn" href="https://play.google.com/store/apps/details?id=com.mkdhapa.digitaldetox&pcampaignid=web_share" target="_blank">
							Install on Google Play
						</a>
					</div>
				</div>

			</section>

			<section class="trust">
				<h2>Why Users Trust Our Apps</h2>
				<ul>
					<li>✅ Regular updates and bug fixes</li>
					<li>✅ Lightweight — no unnecessary permissions</li>
					<li>✅ Fast, clean, and easy to use</li>
					<li>✅ Direct support — just email us</li>
				</ul>
			</section>

			<section class="contact">
				<h2>Questions or Feedback?</h2>
				<p>We read every email and reply fast.</p>
				<p class="cta">
					<a href="mailto:mkpixeltech@gmail.com">📧 mkpixeltech@gmail.com</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		text-align: center;
		padding: 2rem 0;
	}
	.tagline {
		font-size: 1.15em;
		color: rgb(var(--gray-dark));
		max-width: 40rem;
		margin: 1rem auto;
	}
	.cta a {
		display: inline-block;
		background: #01875f; /* Play Store green */
		color: white;
		padding: 0.8rem 1.6rem;
		border-radius: 8px;
		text-decoration: none;
		font-weight: bold;
		margin-top: 0.5rem;
	}
	.app-card {
		display: flex;
		align-items: flex-start;
		gap: 1.5rem;
		background: rgb(var(--gray-light));
		padding: 1.5rem;
		border-radius: 14px;
		margin: 1.5rem 0;
	}
	.app-icon {
		width: 96px;
		height: 96px;
		border-radius: 20px;
		object-fit: cover;
		flex-shrink: 0;
	}
	.badge {
		color: rgb(var(--gray-dark));
		font-size: 0.9em;
		margin: 0.2rem 0;
	}
	.install-btn {
		display: inline-block;
		background: var(--accent);
		color: white;
		padding: 0.6rem 1.2rem;
		border-radius: 8px;
		text-decoration: none;
		font-weight: bold;
		margin-top: 0.5rem;
	}
	.trust {
		padding: 1.5rem 0;
	}
	.trust ul {
		line-height: 2;
	}
	.contact {
		text-align: center;
		padding: 2rem 0;
	}
</style>